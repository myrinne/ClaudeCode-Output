<mxfile host="app.diagrams.net"><diagram id="prisma-scr-v2" name="PRISMA 2020 v2"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1380" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;PRISMA 2020 flow diagram: AI decision support in periodic occupational health examinations (systematized review)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1320" height="30" as="geometry"/></mxCell><mxCell id="h1" value="Identification of studies via databases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="40" width="830" height="30" as="geometry"/></mxCell><mxCell id="h2" value="Identification via other methods" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFC000;strokeColor=#000000;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="980" y="40" width="360" height="30" as="geometry"/></mxCell><mxCell id="p1" value="Identification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="40" height="180" as="geometry"/></mxCell><mxCell id="p2" value="Screening" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="40" height="430" as="geometry"/></mxCell><mxCell id="p3" value="Included" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;fontStyle=1;fontSize=14;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="40" height="150" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b&gt;Records identified from databases (n = 1,278)&lt;/b&gt;&lt;br&gt;PubMed/MEDLINE (n = 478)&lt;br&gt;Scopus (n = 537)&lt;br&gt;ProQuest (n = 128)&lt;br&gt;IEEE Xplore (n = 135)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="80" width="330" height="180" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;Records removed before screening&lt;/b&gt;&lt;br&gt;Duplicate records removed (n = 417)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="80" width="400" height="80" as="geometry"/></mxCell><mxCell id="o1" value="&lt;b&gt;Records identified via supplementary PubMed recall check² (n = 157)&lt;/b&gt;&lt;br&gt;Laboratory terms (n = 117)&lt;br&gt;ECG terms (n = 37)&lt;br&gt;Spirometry terms (n = 3)&lt;br&gt;Audiometry terms (n = 0)&lt;br&gt;(records not retrieved by the main search)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="360" height="180" as="geometry"/></mxCell><mxCell id="b8" value="&lt;b&gt;Records screened by title/abstract (n = 861)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="290" width="330" height="60" as="geometry"/></mxCell><mxCell id="b9" value="&lt;b&gt;Records excluded at title/abstract (n = 838)&lt;/b&gt;&lt;br&gt;E1 population/setting not occupational examination (n = 386)&lt;br&gt;E5 not primary research (n = 147)&lt;br&gt;E3 AI not applied to examination data (n = 106)&lt;br&gt;E2 no AI/ML/NLP (n = 83)&lt;br&gt;E4 prediction/risk model (n = 43)&lt;br&gt;E7 no reference-standard performance (n = 39)&lt;br&gt;E6 non-human (n = 23)&lt;br&gt;E8 published before 2006 (n = 11)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="290" width="400" height="200" as="geometry"/></mxCell><mxCell id="o2" value="&lt;b&gt;Records screened against eligibility criteria (n = 157)&lt;/b&gt;&lt;br&gt;Excluded, out of scope (n = 157): prediction models, wearable monitoring, non-worker or clinical populations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="290" width="360" height="110" as="geometry"/></mxCell><mxCell id="b10" value="&lt;b&gt;Reports sought for retrieval (n = 23)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="330" height="60" as="geometry"/></mxCell><mxCell id="b11" value="&lt;b&gt;Reports not retrieved (n = 3)&lt;/b&gt;&lt;br&gt;No institutional access and not open access (n = 2)&lt;br&gt;Abstract only, cannot be appraised (n = 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="510" width="400" height="70" as="geometry"/></mxCell><mxCell id="b12" value="&lt;b&gt;Reports assessed for eligibility¹ (n = 20)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#000000;fontSize=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="330" height="60" as="geometry"/></mxCell><mxCell id="b13" value="&lt;b&gt;Reports excluded at full text (n = 7)&lt;/b&gt;&lt;br&gt;E10 CT/HRCT, not a periodic-examination test (n = 3)&lt;br&gt;E4 prediction model (n = 2)&lt;br&gt;E7 no reference-standard performance (n = 1)&lt;br&gt;E9 micronodule risk grading, no detection task (n = 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="520" y="600" width="400" height="120" as="geometry"/></mxCell><mxCell id="b14" value="&lt;b&gt;Studies included in the review (n = 13)&lt;/b&gt;&lt;br&gt;Reports of included studies (n = 13)&lt;br&gt;Chest radiography (n = 9)&lt;br&gt;Audiometry (n = 1)&lt;br&gt;ECG (n = 1)&lt;br&gt;Multimodal examination data / records (n = 2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#548235;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="90" y="750" width="330" height="150" as="geometry"/></mxCell><mxCell id="o3" value="&lt;b&gt;Studies added from other methods (n = 0)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="980" y="790" width="360" height="60" as="geometry"/></mxCell><mxCell id="fn" value="¹ Full-text eligibility (rule set 7 Oct 2026): population judged together with the index test. Workers or ex-workers examined with a test used in periodic or pre-placement occupational examinations were eligible from screening, surveillance, clinic or claims settings. E9 and E10 were defined at full text; title/abstract decisions preceded this rule.&lt;br&gt;² PubMed probe (6 Oct 2026): AI terms AND modality terms AND worker terms, 2006 onwards, run because laboratory and ECG terms were absent from the main strings; counts are records not already retrieved by the main search." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="915" width="1250" height="60" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="b6" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="b8" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="b10" target="b12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="b12" target="b13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="b12" target="b14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="o1" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1" source="o2" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>